# 统一按 LF 存储与检出：脚本在 WSL 内执行，CRLF 会导致
# "bash: $'\r': command not found" 一类错误。
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.mk    text eol=lf
*.bp    text eol=lf
*.prop  text eol=lf
*.rc    text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf

# Windows 批处理必须 CRLF：cmd.exe 用 LF 时 if(...) 多行块会解析失败
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制：不做行尾转换
*.img   binary
*.dtb   binary
*.dtbo  binary
*.ko    binary
*.apk   binary
*.jar   binary
*.zip   binary
*.png   binary
*.jpg   binary
