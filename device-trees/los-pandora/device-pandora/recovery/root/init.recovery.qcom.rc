on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

on late-init
    # Mount vendor_dlkm and load the minimal touch modules early.
    start load_touch_modules

on property:orangefox.postinit.status=1
    # Run a second pass after OrangeFox startup in case the first pass raced.
    start load_touch_modules

service load_touch_modules /system/bin/sh /sbin/load_touch_modules.sh
    class core
    user root
    group root system input
    seclabel u:r:recovery:s0
    oneshot

# ── LOS 23.2: 启动 AIDL boot HAL ──────────────────────────────────
# LOS 23.2 的 update_engine 已经不支持 HIDL 1.1（只认 AIDL 的
# android.hardware.boot.IBootControl）。AOSP 提供的
# android.hardware.boot-service.default_recovery 属于 class early_hal，
# 而 recovery 的 init.rc 在 `on boot` 里只做了 class_start default / hal，
# 不会启动 early_hal —— 结果是服务永远不起，update_engine 报
#   Error getting bootctrl module
# 这里显式补一次。
on boot
    class_start early_hal

# ── rc-mode: USB 模式切换的确定性时序 ────────────────────────────
# sys.usb.ffs.ready 是 adb / fastboot 共用的全局标志，adbd 存活时它就是 1。
# 若在 adbd 还活着时切到 fastboot，init.recovery.usb.rc 的 fastboot 分支会立刻
# 触发，在 fastbootd 尚未启动、ffs.fastboot 还没有描述符时就去绑定 UDC ——
# 主机枚举到一个空设备，fastbootd 随后又起不来，最终 gadget 处于解绑状态，
# 表现为"电脑上 USB 设备整个消失"。
# 因此切换前必须先停掉旧服务并清零 ffs.ready，再启动新服务。
on property:sys.usb.config=fastboot
    stop adbd
    setprop sys.usb.ffs.ready 0
    start fastbootd

on property:sys.usb.config=adb
    stop fastbootd
    setprop sys.usb.ffs.ready 0
    start adbd
