			tlmm-vm-gpio-list = <0x30 0x57 0x00 0x30 0x61 0x00 0x30 0x30 0x00 0x30 0x31 0x00 0x30 0x32 0x00 0x30 0x33 0x00 0x30 0x9e 0x00 0x30 0x42 0x00 0x30 0x64 0x00 0x30 0x08 0x00 0x30 0x09 0x00 0x30 0x0a 0x00 0x30 0x0b 0x00>;
