		bamdma@6C04000 {
			compatible = "qcom,bam-v1.7.0";
			qcom,controlled-remotely;
			reg = <0x00 0x6c04000 0x00 0x20000 0x00 0x6c8f000 0x00 0x1000>;
			reg-names = "bam\0bam_remote_mem";
			num-channels = <0x1f>;
			interrupts = <0x00 0xa4 0x04>;
			#dma-cells = <0x01>;
			qcom,ee = <0x01>;
			qcom,num-ees = <0x02>;
			phandle = <0x31>;
		};

		slim@6C40000 {
			compatible = "qcom,slim-ngd-v1.5.0";
			reg = <0x00 0x6c40000 0x00 0x2c000 0x00 0x6c8e000 0x00 0x1000>;
			reg-names = "ctrl\0slimbus_remote_mem";
			interrupts = <0x00 0xa3 0x04>;
			dmas = <0x31 0x03 0x31 0x04>;
			dma-names = "rx\0tx";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
			phandle = <0x425>;
		};

