	ddr-regions {
	};

	firmware {
		phandle = <0x393>;

		qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x02 0x19000>;
			phandle = <0x27c>;
		};

		qcom_smcinvoke {
			compatible = "qcom,smcinvoke";
		};

		qcom_mem_object {
			compatible = "qcom,mem-object";
		};

		qtee_shmbridge {
			compatible = "qcom,tee-shared-memory-bridge";
		};

		sdei {
			compatible = "arm,sdei-1.0";
			method = "hvc";
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			power-domains = <0x04>;
