			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0xee>;
			clocks = <0x05 0x00>;
			next-level-cache = <0x06>;
			phandle = <0x10>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x06>;
			};
		};

