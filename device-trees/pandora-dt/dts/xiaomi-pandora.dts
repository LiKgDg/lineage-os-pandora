			lpass-cdc {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				qcom,num-macros = <0x05>;
				qcom,lpass-cdc-version = <0x07>;
				phandle = <0x5bc>;
				clocks = <0x5b3 0x00 0x5b4 0x00>;
				clock-names = "lpass_core_hw_vote\0lpass_audio_hw_vote";
				compatible = "qcom,lpass-cdc";

				wcd937x-codec {
					status = "disabled";
