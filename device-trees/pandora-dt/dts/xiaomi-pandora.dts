				qcom,label = <0x08>;
				qcom,vmid = <0x2d>;
				tlmm-vm-gpio-list = <0x30 0x56 0x00 0x30 0x57 0x00 0x30 0x61 0x00 0x30 0x62 0x00 0x30 0x30 0x00 0x30 0x31 0x00 0x30 0x32 0x00 0x30 0x33 0x00 0x30 0x9e 0x00 0x30 0x42 0x00 0x30 0x64 0x00 0x30 0x08 0x00 0x30 0x09 0x00 0x30 0x0a 0x00 0x30 0x0b 0x00 0x30 0x58 0x00>;
			};
		};

